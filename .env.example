OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAQ secondary data source — optional, unauthenticated access works at lower rate limits
# Register at https://explore.openaq.org/ to get a free API key
OPENAQ_API_KEY=

DATABASE_URL=postgresql+asyncpg://aqi_user:your_password@db:5432/aqi_db
POSTGRES_USER=aqi_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=aqi_db

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@gmail.com

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

# BigQuery data warehouse (optional — leave blank to use PostgreSQL-only mode)
# Create a GCP service account with the BigQuery Data Editor and Job User roles,
# then paste the entire contents of the downloaded JSON key below (single line).
# Alternatively, set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json on the host.
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=aqi_warehouse
BIGQUERY_DATASET_LOCATION=US
BIGQUERY_CREDENTIALS_JSON=
